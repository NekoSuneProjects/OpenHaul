{
  "name": "openhaul",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @openhaul/api",
    "dev:web": "npm run dev -w @openhaul/web",
    "dev:bot": "npm run dev -w @openhaul/bot",
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "map:import": "node tools/maps/import-pmtiles.mjs",
    "map:publish": "node tools/maps/publish-maps.mjs",
    "test:maps": "tsx --test apps/api/tests/maps.test.ts"
  },
  "engines": {
    "node": ">=22"
  }
}
