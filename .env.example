# ============================================================
# OpenHaul environment
# ============================================================
# Main hosted instance:
#   https://openhaul.nekosunevr.co.uk/
#   https://openhaul.nekosunevr.co.uk/api/...
#
# OpenHaul now serves the website + API from ONE public origin.
# The merged OpenHaul container exposes only port 3000.
# Internally:
#   Nginx gateway -> :3000
#   Fastify API   -> :3001
#   Next.js web   -> :3002
# ============================================================


# ------------------------------------------------------------
# Public URL / networking
# ------------------------------------------------------------

APP_URL=https://openhaul.nekosunevr.co.uk

# Host port published by Docker.
OPENHAUL_PORT=3000

# Internal API process port inside the merged OpenHaul container.
# Do not expose this publicly.
API_PORT=3001

# Leave blank for same-origin API requests.
# Browser requests will use:
#   /api/...
#
# Self-hosters should normally keep this blank too.
NEXT_PUBLIC_API_URL=

# Public URL used by server-generated callbacks and account flows.
OPENHAUL_PUBLIC_API_URL=https://openhaul.nekosunevr.co.uk

# Steam OpenID realm. Must normally end with a slash.
OPENHAUL_STEAM_REALM=https://openhaul.nekosunevr.co.uk/

# true for HTTPS production deployments.
# Use false only for local HTTP development.
OPENHAUL_COOKIE_SECURE=true


# ------------------------------------------------------------
# Live-map base layers
# ------------------------------------------------------------

# Road mode uses OpenStreetMap by default.
NEXT_PUBLIC_MAP_ROAD_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Satellite mode uses Esri World Imagery by default.
NEXT_PUBLIC_MAP_SATELLITE_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_DB=openhaul
POSTGRES_USER=openhaul

# Change this before production use.
POSTGRES_PASSWORD=change-me

# Docker Compose service hostname is "postgres".
DATABASE_URL=postgres://openhaul:change-me@postgres:5432/openhaul


# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------

# Docker Compose service hostname is "redis".
REDIS_URL=redis://redis:6379


# ------------------------------------------------------------
# OpenHaul administration / telemetry
# ------------------------------------------------------------

# Instance-level administration/testing telemetry credential.
# Normal Windows users DO NOT need this.
# The GUI client signs in through Steam and receives its own
# server-generated oh_client_... token automatically.
OPENHAUL_INGEST_KEY=change-this-ingest-key

# Instance administration credential.
OPENHAUL_ADMIN_KEY=change-this-admin-key


# ------------------------------------------------------------
# Steam account login / ownership / DLC lookup
# ------------------------------------------------------------

# Steam Web API key used for profile/library/ownership lookup.
STEAM_WEB_API_KEY=


# ------------------------------------------------------------
# Windows Client
# ------------------------------------------------------------

# No OPENHAUL_CLIENT_TOKEN is required in this server .env.
#
# The Windows GUI client:
#   1. defaults to https://openhaul.nekosunevr.co.uk
#   2. lets self-hosters enter their own server URL
#   3. signs the user in through Steam
#   4. creates a revocable oh_client_... token server-side
#   5. saves that token in the user's local Windows profile
#   6. checks launcher + telemetry updates automatically
#
# Rolling client release:
# https://github.com/NekoSuneProjects/OpenHaul/releases/tag/windows-client
#
# Stable installer:
# https://github.com/NekoSuneProjects/OpenHaul/releases/download/windows-client/OpenHaul-Setup.exe
#
# Update manifest:
# https://github.com/NekoSuneProjects/OpenHaul/releases/download/windows-client/client-manifest.json


# ------------------------------------------------------------
# TruckersMP server status
# ------------------------------------------------------------

# OpenHaul exposes TruckersMP live server/player counts through:
#   /api/v1/public/truckersmp/servers
#
# OpenHaul's own active telemetry-player counts are exposed through:
#   /api/v1/public/openhaul/status
#
# No extra API key is currently required.


# ------------------------------------------------------------
# Map data / PMTiles automatic updates
# ------------------------------------------------------------

# Inside Docker this is overridden to /data-runtime/maps.
# Keep this value useful for native/non-Docker runs.
OPENHAUL_MAP_DATA_DIR=./data-runtime/maps

# Download maintainer-published ETS2/ATS PMTiles automatically.
OPENHAUL_MAP_AUTO_UPDATE=true

# Rolling GitHub map manifest.
OPENHAUL_MAP_MANIFEST_URL=https://github.com/NekoSuneProjects/OpenHaul/releases/download/map-data/maps.json

# Check on startup, then every N hours.
# Supported range: 1-168.
OPENHAUL_MAP_UPDATE_HOURS=6


# ------------------------------------------------------------
# Optional first VTC bootstrap
# ------------------------------------------------------------

OPENHAUL_BOOTSTRAP_VTC_NAME=My VTC
OPENHAUL_BOOTSTRAP_VTC_SLUG=my-vtc
OPENHAUL_BOOTSTRAP_VTC_TAG=VTC

# Raw VTC key is hashed before storage.
OPENHAUL_BOOTSTRAP_VTC_API_KEY=oh_vtc_change-me

OPENHAUL_BOOTSTRAP_VTC_API_SCOPES=telemetry:read,jobs:read,fines:read,statistics:read,members:read


# ------------------------------------------------------------
# Discord bot (optional)
# ------------------------------------------------------------

# Create one Discord application/bot for the OpenHaul instance.
# VTC owners then install that shared bot into their own Discord server
# and configure their Guild/channel IDs from the VTC management page.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Long random secret shared only between the OpenHaul API and bot container.
# Example generation:
#   openssl rand -hex 32
OPENHAUL_BOT_SERVICE_KEY=change-this-to-a-long-random-secret

# Legacy single-VTC bot variables are no longer required for the
# multi-VTC integration. Keep OPENHAUL_VTC_API_KEY only if you have
# an older custom deployment still using the previous bot build.
OPENHAUL_VTC_API_KEY=
DISCORD_GUILD_ID=
DISCORD_FINE_CHANNEL_ID=
DISCORD_JOB_CHANNEL_ID=
DISCORD_DRIVER_CHANNEL_ID=


# ------------------------------------------------------------
# TruckersFM
# ------------------------------------------------------------

TRUCKERSFM_NOWPLAYING_URL=https://azuracast.truckers.fm/api/nowplaying/1

# ------------------------------------------------------------
# Direct radio playback / optional local-compatible transcoding
RADIO_CHSL_SOURCE_URL=https://stingray.leanstream.co/CHSLFM?args=web_01&aw_0_req.gdpr=true&gdpr=true
RADIO_CHSL_BITRATE_KBPS=128

# Low-latency FFmpeg startup tuning for live radio.
# Smaller probe/analyse values make ATS/ETS2 radio begin playing faster.
RADIO_FFMPEG_PROBESIZE=65536
RADIO_FFMPEG_ANALYZEDURATION_US=250000
RADIO_FFMPEG_RW_TIMEOUT_US=8000000

# Optional custom direct stations.
# RADIO_STATIONS_JSON=[{"id":"us-rock","name":"US Rock","sourceUrl":"https://example.com/live.aac","country":"US","bitrateKbps":128,"genre":"Rock","language":"EN"}]
RADIO_STATIONS_JSON=[]

# Worldwide directory backing the Radio page.
# Radio Browser provides country/codec/bitrate/tags/health metadata.
RADIO_BROWSER_API_URL=https://de1.api.radio-browser.info
# Optional base URL for the dedicated radio-catalog branch.
# Example: https://raw.githubusercontent.com/NekoSuneProjects/OpenHaul/radio-catalog
NEXT_PUBLIC_RADIO_CATALOG_URL=

# Optional comma-separated Radio Browser mirrors. If left blank OpenHaul
# discovers current mirrors from all.api.radio-browser.info and falls back to
# RADIO_BROWSER_API_URL.
RADIO_BROWSER_API_URLS=

# Additional public radio discovery sources.
# Internet-Radio.com is consumed server-side from its public search pages and
# .m3u/.pls playlist links (it does not expose a documented general search API).
INTERNET_RADIO_DIRECTORY_URL=https://www.internet-radio.com

# Xiph public Icecast directory.
XIPH_DIRECTORY_URL=https://dir.xiph.org

# Public laut.fm API.
LAUTFM_API_URL=https://api.laut.fm

# Optional geo-routing overrides for Radio Browser stations that are known
# to reject listeners outside a country/region. Public stations are NOT proxied.

# Optional URL/provider geo rules used when scanning uploaded live_streams.sii files.
# This is for providers that return a valid spoken "not available in your region"
# audio stream instead of failing HTTP/codec checks.
# Match is a case-insensitive substring of the source URL.
# CHSL/LeanStream -> CA is built in already.
#
# Example:


# ------------------------------------------------------------
# Donations / DLC funding goals
# ------------------------------------------------------------

DONATIONS_ENABLED=true

# Ko-fi page used by the Support page donation buttons.
# Example: https://ko-fi.com/yourname
KOFI_URL=

OPENHAUL_BOOTSTRAP_GOAL_TITLE=ETS2 / ATS DLC Fund
OPENHAUL_BOOTSTRAP_GOAL_DESCRIPTION=Help fund map and cargo DLC for larger OpenHaul community convoys.
OPENHAUL_BOOTSTRAP_GOAL_CURRENCY=GBP
OPENHAUL_BOOTSTRAP_GOAL_TARGET=100
OPENHAUL_BOOTSTRAP_GOAL_CURRENT=0

# Payments are handled externally by Ko-fi; OpenHaul only tracks/display funding goals.


# ------------------------------------------------------------
# Twitch account linking / live streamer detection
# ------------------------------------------------------------

# Register a Twitch application and configure this redirect:
# https://openhaul.nekosunevr.co.uk/api/v1/auth/twitch/callback
#
# For a self-hosted domain:
# <OPENHAUL_PUBLIC_API_URL>/api/v1/auth/twitch/callback

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=


# Optional but recommended: signs generated long-lived OpenHaul radio repair URLs.
# Set this to a random secret on public deployments.
RADIO_RELAY_SIGNING_SECRET=


# ------------------------------------------------------------
# Optional SHOUTcast Directory API
# ------------------------------------------------------------
# SHOUTcast directory API access requires a valid developer/partner API key.
# Leave blank to disable SHOUTcast discovery.
SHOUTCAST_API_URL=https://api.shoutcast.com
SHOUTCAST_API_KEY=

# Countries used by the geo-probe endpoint when no explicit list is supplied.


